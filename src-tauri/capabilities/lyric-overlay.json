  "permissions": ["core:event:default", "core:window:allow-start-dragging", "core:window:allow-start-resize-dragging", "core:window:allow-outer-position", "core:window:allow-set-position", "core:window:allow-inner-size", "core:window:allow-set-size", "core:window:allow-scale-factor"]
}
