<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_art_bg"
        android:src="@drawable/widget_art_demo"
        android:scaleType="centerCrop"
        android:contentDescription="Album artwork" />

    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Blinding Lights" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#C4B5FD"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:text="The Weeknd" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_widget_prev"
            android:scaleType="centerInside"
            android:contentDescription="Previous track" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_btn_bg"
            android:src="@drawable/ic_widget_pause"
            android:scaleType="centerInside"
            android:contentDescription="Play or pause" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_widget_next"
            android:scaleType="centerInside"
            android:contentDescription="Next track" />
    </LinearLayout>
</LinearLayout>
